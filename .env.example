# ============================================================
# Buffet System — Environment Variables (copy to .env)
# ============================================================

# --- Database (local Docker Postgres by default; use Neon URL in prod) ---
DATABASE_URL="postgresql://buffet:buffet@localhost:5432/buffet?sslmode=disable"

# --- Better-Auth ---
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="change-me-in-production"
# Base URL where the Better-Auth handler is mounted (the Nest API)
BETTER_AUTH_URL="http://localhost:3333"

# --- Web (Next.js) ---
# URL of the Nest API (Better-Auth handler + REST endpoints)
NEXT_PUBLIC_API_URL="http://localhost:3333"
# Public base URL of the web app (used for public onboarding links /{slug})
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Trusted origins for auth (comma-separated) ---
TRUSTED_ORIGINS="http://localhost:3000"
