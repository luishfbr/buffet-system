# ============================================================
# Buffet System — Environment Variables (copy to .env)
# ============================================================

# --- Database (local Docker Postgres by default; use Neon URL in prod) ---
DATABASE_URL="postgresql://buffet:buffet@localhost:5432/buffet?sslmode=disable"

# --- Better-Auth ---
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="change-me-in-production"
# Base URL where the Better-Auth handler is mounted (the Nest API)
BETTER_AUTH_URL="http://localhost:3333"

# --- Web (Next.js) ---
# URL of the Nest API (Better-Auth handler + REST endpoints)
NEXT_PUBLIC_API_URL="http://localhost:3333"
# Public base URL of the web app (used for public onboarding links /{slug})
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Trusted origins for auth (comma-separated) ---
# O redirectTo do reset de senha (RF33) é validado contra esta lista.
TRUSTED_ORIGINS="http://localhost:3000"

# --- Proxy (RNF06) ---
# Número de proxies confiáveis à frente da API (ex.: "1" atrás de um load
# balancer). VAZIO em desenvolvimento: sem proxy na frente, confiar no header
# deixaria o cliente forjar X-Forwarded-For e escapar do rate limit por IP do
# formulário público. Defina em produção, senão o limite de 5/min vira um balde
# único compartilhado por todos os visitantes.
TRUST_PROXY=""

# --- E-mail transacional (RNF09 / RF32-RF34) ---
# VAZIO = driver console: o e-mail é impresso no terminal da API, com o link
# clicável. Reset de senha e convite funcionam ponta a ponta sem provedor.
# Para enviar de verdade, crie uma chave em https://resend.com.
RESEND_API_KEY=""
# Remetente. O domínio `resend.dev` só entrega para o e-mail dono da conta
# Resend — em produção, verifique seu próprio domínio.
MAIL_FROM="Buffet System <onboarding@resend.dev>"
# Base pública do app; a API monta os links do painel nos e-mails com ela.
# Var própria (e não NEXT_PUBLIC_APP_URL) porque quem consome é o backend.
APP_URL="http://localhost:3000"

# --- Image storage (RNF07) ---
# Defaults match the MinIO service in docker-compose.yml — no setup needed locally.
# Swapping to another S3-compatible provider is a change of these values, not of code.
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="buffet-assets"
S3_ACCESS_KEY_ID="buffet"
S3_SECRET_ACCESS_KEY="buffetdev123"
# Public base URL objects are served from. Every stored image URL must start with this.
PUBLIC_ASSET_BASE_URL="http://localhost:9000/buffet-assets"
