{
  "name": "@buffet/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "generate": "drizzle-kit generate",
    "migrate": "dotenv -e ../../.env -- npx drizzle-kit migrate",
    "push": "dotenv -e ../../.env -- npx drizzle-kit push",
    "studio": "dotenv -e ../../.env -- npx drizzle-kit studio",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "dotenv-cli": "^11.0.0",
    "drizzle-orm": "^0.38.3",
    "pg": "^8.13.1",
    "uuidv7": "^1.0.2"
  },
  "devDependencies": {
    "@buffet/config": "workspace:*",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.30.1",
    "typescript": "^5.7.2"
  }
}
