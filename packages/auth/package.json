{
  "name": "@buffet/auth",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./src/client.ts",
      "import": "./dist/client.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@buffet/db": "workspace:*",
    "@buffet/shared": "workspace:*",
    "better-auth": "^1.1.9"
  },
  "devDependencies": {
    "@buffet/config": "workspace:*",
    "typescript": "^5.7.2"
  }
}
